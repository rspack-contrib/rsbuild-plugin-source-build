{
  "name": "@rsbuild/plugin-source-build",
  "version": "1.0.6",
  "description": "An Rsbuild plugin to provide support for monorepo source code referencing.",
  "repository": "https://github.com/rstackjs/rsbuild-plugin-source-build",
  "homepage": "https://github.com/rstackjs/rsbuild-plugin-source-build#readme",
  "bugs": {
    "url": "https://github.com/rstackjs/rsbuild-plugin-source-build/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib",
    "dev": "rslib -w",
    "lint": "rslint && prettier -c .",
    "lint:write": "rslint --fix && prettier -w .",
    "prepare": "simple-git-hooks",
    "test": "rstest",
    "bump": "pnpx bumpp"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint:write"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "json5": "^2.2.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.13",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "^0.8.0",
    "@rstest/core": "^0.11.8",
    "@rstest/playwright": "^0.11.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-git-hooks": "^2.13.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.21.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
